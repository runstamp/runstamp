{
  "name": "@runstamp/pptx",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Generate PowerPoint files from JSON. The full engine: templates, accessibility, charts and PDF conversion, Apache-2.0.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/runstamp/runstamp",
    "directory": "packages/pptx"
  },
  "homepage": "https://runstamp.com",
  "bugs": "https://github.com/runstamp/runstamp/issues",
  "keywords": [
    "json-to-pptx",
    "pptx",
    "document-generation",
    "powerpoint",
    "open-source"
  ],
  "files": [
    "dist-pro",
    "docs",
    "examples",
    "quickstart",
    "README.md",
    "CHANGELOG.md",
    "UPGRADE.md",
    "LICENSE"
  ],
  "main": "./dist-pro/index.js",
  "types": "./dist-pro/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-pro/types/index.d.ts",
      "import": "./dist-pro/index.js",
      "default": "./dist-pro/index.js"
    },
    "./engine": {
      "types": "./dist-pro/types/engine.d.ts",
      "import": "./dist-pro/public/engine.js",
      "default": "./dist-pro/public/engine.js"
    },
    "./interpreter": {
      "types": "./dist-pro/types/interpreter.d.ts",
      "import": "./dist-pro/public/interpreter.js",
      "default": "./dist-pro/public/interpreter.js"
    },
    "./validator": {
      "types": "./dist-pro/types/validator.d.ts",
      "import": "./dist-pro/public/validator.js",
      "default": "./dist-pro/public/validator.js"
    },
    "./quality": {
      "types": "./dist-pro/types/quality.d.ts",
      "import": "./dist-pro/public/quality.js",
      "default": "./dist-pro/public/quality.js"
    },
    "./renderer": {
      "types": "./dist-pro/types/renderer.d.ts",
      "import": "./dist-pro/public/renderer.js",
      "default": "./dist-pro/public/renderer.js"
    },
    "./ops": {
      "types": "./dist-pro/types/ops/index.d.ts",
      "import": "./dist-pro/ops/index.js",
      "default": "./dist-pro/ops/index.js"
    },
    "./ops/descriptor": {
      "types": "./dist-pro/types/ops/descriptor.d.ts",
      "import": "./dist-pro/ops/descriptor.js",
      "default": "./dist-pro/ops/descriptor.js"
    },
    "./lite": {
      "types": "./dist-pro/types/index.d.ts",
      "import": "./dist-pro/index-lite.js",
      "default": "./dist-pro/index-lite.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist dist-pro",
    "build": "pnpm --filter @runstamp/protocol build && pnpm --filter @runstamp/pptx-extractor build && pnpm --filter @runstamp/pptx-primitives build && pnpm --filter @runstamp/document-diff build && pnpm clean && node build.mjs",
    "build:free": "rm -rf dist && node scripts/build-free.mjs",
    "build:pro": "rm -rf dist-pro && node scripts/build-pro.mjs",
    "build:dev": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @runstamp/protocol build && pnpm --filter @runstamp/pptx-primitives build && pnpm --filter @runstamp/document-diff build && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm exec eslint src tests scripts *.config.ts",
    "test": "pnpm --filter @runstamp/protocol build && pnpm --filter @runstamp/pptx-primitives build && pnpm --filter @runstamp/document-diff build && pnpm --filter @runstamp/pptx-extractor build && pnpm test:nonvisual",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:nonvisual": "vitest run --config vitest.config.ts",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "UPDATE_GOLDEN=1 vitest run --config vitest.visual.config.ts",
    "test:visual:quick": "VISUAL_QUICK=1 vitest run --config vitest.visual.config.ts",
    "test:visual:docker": "docker compose -f ../../docker-compose.visual.yml up --build --exit-code-from visual-regression",
    "test:fidelity": "vitest run --config vitest.fidelity.config.ts",
    "test:oracle": "vitest run --config vitest.oracle.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "corpus:build": "npx tsx scripts/desktopValidation/buildCorpus.ts",
    "corpus:ingest": "npx tsx scripts/desktopValidation/ingestCorpusCase.ts",
    "validate:pptx": "npx tsx scripts/desktopValidation/validatePptx.ts",
    "validate:pptx:windows-oracle": "npx tsx scripts/desktopValidation/runWindowsOracle.ts",
    "validate:pptx:mac-oracle": "npx tsx scripts/desktopValidation/runMacOracle.ts",
    "validate:pptx:google-slides-oracle": "npx tsx scripts/desktopValidation/runGoogleSlidesOracle.ts",
    "validate:pptx:platform-smoke": "npx tsx scripts/desktopValidation/platformStudioSmoke.ts",
    "pptx:robustness:baseline": "tsx scripts/robustness/baseline.ts",
    "pptx:robustness:fuzz": "tsx scripts/robustness/fuzz.ts",
    "sota:local": "vite-node scripts/sotaLab/runLocalSota.ts",
    "sota:worker:windows": "vite-node scripts/sotaLab/windowsWorker.ts",
    "sota:health": "vite-node scripts/sotaLab/health.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@runstamp/document-diff": "workspace:*",
    "@runstamp/pptx-extractor": "workspace:*",
    "@runstamp/pptx-primitives": "workspace:*",
    "@runstamp/protocol": "workspace:*",
    "@runstamp/pvce": "workspace:*",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "base64-js": "^1.5.1",
    "esbuild": "^0.25.11",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "require-from-string": "^2.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.4",
    "yoga-wasm-web": "0.3.3"
  },
  "dependencies": {
    "@runstamp/contract": "workspace:*",
    "@runstamp/pdf": "workspace:*",
    "@swc/helpers": "^0.5.12",
    "bidi-js": "1.0.3",
    "brotli": "^1.3.2",
    "clone": "^2.1.2",
    "dfa": "^1.2.0",
    "fast-deep-equal": "^3.1.3",
    "fast-xml-parser": "^5.5.7",
    "fontkit": "^2.0.4",
    "harfbuzzjs": "0.8.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "linebreak": "^1.1.0",
    "pako": "^2.1.0",
    "pngjs": "^7.0.0",
    "restructure": "^3.0.0",
    "subset-font": "^2.4.0",
    "tiny-inflate": "^1.0.3",
    "tslib": "^2.8.1",
    "unicode-properties": "^1.4.0",
    "unicode-trie": "^2.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "echarts": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "runstamp": {
    "packCheck": {
      "forbiddenImportSpecifiers": [
        "@runstamp/license",
        "@runstamp/protocol",
        "@runstamp/pvce"
      ]
    },
    "publicSourceMode": "independently-buildable"
  }
}
