{
  "name": "@runstamp/pvce",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Precision-Vector Charting Engine for Runstamp packages",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src *.config.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/runstamp/runstamp",
    "directory": "packages/pvce"
  },
  "bugs": "https://github.com/runstamp/runstamp/issues",
  "homepage": "https://runstamp.com",
  "runstamp": {
    "publicSourceMode": "independently-buildable"
  }
}
