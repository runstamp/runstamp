{
  "name": "@runstamp/pdf",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Generate PDF files from JSON",
  "packageManager": "pnpm@10.12.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/runstamp/runstamp",
    "directory": "packages/pdf"
  },
  "homepage": "https://runstamp.com",
  "bugs": "https://github.com/runstamp/runstamp/issues",
  "keywords": [
    "json-to-pdf",
    "pdf",
    "document-generation",
    "pdf-writer"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./ops/descriptor": {
      "types": "./dist/ops/descriptor.d.ts",
      "import": "./dist/ops/descriptor.js"
    }
  },
  "files": [
    "dist",
    "fixtures/fonts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @runstamp/protocol build && pnpm clean && node scripts/build-free.mjs",
    "build:free": "rm -rf dist && node scripts/build-free.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @runstamp/protocol build && tsc --noEmit",
    "lint": "pnpm exec eslint src __tests__ scripts *.config.ts",
    "test": "pnpm --filter @runstamp/protocol build && vitest run",
    "benchmark:phase1": "pnpm exec tsx scripts/benchmark-phase1.ts",
    "ensure:phase2-fonts": "pnpm exec tsx scripts/phase2-font-fixtures.ts",
    "benchmark:phase2": "pnpm exec tsx scripts/benchmark-phase2.ts",
    "benchmark:phase3": "pnpm exec tsx scripts/benchmark-phase3.ts",
    "benchmark:phase4": "pnpm exec tsx scripts/benchmark-phase4.ts",
    "benchmark:phase5": "pnpm exec tsx scripts/benchmark-phase5.ts",
    "benchmark:phase6": "pnpm exec tsx scripts/benchmark-phase6.ts",
    "benchmark:phase7": "pnpm exec tsx scripts/benchmark-phase7.ts",
    "benchmark:phase8": "pnpm exec tsx scripts/benchmark-phase8.ts",
    "benchmark:phase9": "pnpm exec tsx scripts/benchmark-phase9.ts",
    "ensure:phase10-certs": "pnpm exec tsx scripts/phase10-fixtures.ts",
    "benchmark:phase10": "pnpm exec tsx scripts/benchmark-phase10.ts",
    "benchmark:evidence": "pnpm exec tsx scripts/benchmark-evidence-processing.ts",
    "benchmark:0410": "pnpm exec tsx scripts/benchmark-pdf-0410.ts",
    "benchmark:0410:acrobat-checklist": "pnpm exec tsx scripts/benchmark-pdf-008-acrobat-checklist.ts",
    "pdf:robustness:baseline": "node scripts/pdf-robustness.mjs baseline",
    "pdf:robustness:ci": "node scripts/pdf-robustness.mjs ci",
    "pdf:robustness:full": "node scripts/pdf-robustness.mjs full",
    "pdf:robustness:quick": "node scripts/pdf-robustness.mjs quick",
    "pdf:robustness:release": "node scripts/pdf-robustness.mjs release",
    "validate:qpdf": "pnpm exec tsx scripts/validate-qpdf.ts"
  },
  "dependencies": {
    "@runstamp/contract": "workspace:*",
    "@swc/helpers": "^0.5.12",
    "bidi-js": "1.0.3",
    "brotli": "^1.3.2",
    "clone": "^2.1.2",
    "dfa": "^1.2.0",
    "fast-deep-equal": "^3.1.3",
    "fast-xml-parser": "^5.5.7",
    "fontkit": "^2.0.4",
    "harfbuzzjs": "0.8.0",
    "pako": "^2.1.0",
    "pngjs": "^7.0.0",
    "restructure": "^3.0.0",
    "subset-font": "^2.4.0",
    "tiny-inflate": "^1.0.3",
    "tslib": "^2.8.1",
    "unicode-properties": "^1.4.0",
    "unicode-trie": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@runstamp/protocol": "workspace:*",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.4",
    "@types/pngjs": "^6.0.5",
    "base64-js": "^1.5.1",
    "esbuild": "^0.25.11",
    "jpeg-js": "^0.4.4",
    "require-from-string": "^2.0.2",
    "tsup": "^8.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4",
    "yoga-wasm-web": "0.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "runstamp": {
    "packCheck": {
      "declarationGraph": true,
      "forbiddenImportSpecifiers": [
        "@runstamp/license"
      ]
    },
    "publicSourceMode": "independently-buildable"
  }
}
