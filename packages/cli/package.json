{
  "name": "@runstamp/cli",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Command-line renderer for Runstamp JSON document specs",
  "license": "Apache-2.0",
  "author": "Runstamp <hello@runstamp.com> (https://runstamp.com)",
  "homepage": "https://runstamp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/runstamp/runstamp",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/runstamp/runstamp/issues",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "bin": {
    "runstamp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src __tests__ *.config.ts",
    "test": "vitest run",
    "check:release": "pnpm prepublishOnly"
  },
  "dependencies": {
    "@runstamp/catalog": "workspace:^",
    "@runstamp/docx": "workspace:*",
    "@runstamp/pdf": "workspace:*",
    "@runstamp/pptx": "workspace:*",
    "@runstamp/xlsx": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "runstamp": {
    "publicSourceMode": "independently-buildable"
  }
}
