{
  "name": "@runstamp/docx",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Generate Word documents from JSON",
  "packageManager": "pnpm@10.12.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/runstamp/runstamp",
    "directory": "packages/docx"
  },
  "homepage": "https://runstamp.com",
  "bugs": "https://github.com/runstamp/runstamp/issues",
  "keywords": [
    "json-to-docx",
    "docx",
    "document-generation",
    "word",
    "charts",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js",
      "default": "./dist/ops/index.js"
    },
    "./ops/descriptor": {
      "types": "./dist/ops/descriptor.d.ts",
      "import": "./dist/ops/descriptor.js",
      "default": "./dist/ops/descriptor.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @runstamp/pvce build && pnpm --filter @runstamp/document-diff build && pnpm --filter @runstamp/protocol build && pnpm --filter @runstamp/pdf build && pnpm clean && node scripts/build-free.mjs",
    "build:free": "pnpm --filter @runstamp/pvce build && pnpm --filter @runstamp/protocol build && rm -rf dist && node scripts/build-free.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "fixtures:manual-validation": "node scripts/generate-manual-validation.mjs",
    "oracle:word": "node scripts/run-word-oracle.mjs",
    "a01:reference-gate": "node scripts/a01-reference-gate.mjs",
    "check:docx-validator": "node scripts/check-docx-validator.mjs",
    "check:docx-static-gate": "node scripts/check-docx-static-gate.mjs",
    "check:release-candidate": "node scripts/check-release-candidate.mjs",
    "check:runtime-compatibility": "node scripts/check-runtime-compatibility.mjs",
    "check:source-mode": "pnpm exec tsx scripts/check-source-mode.ts",
    "check:bundle": "node scripts/bundle-check.mjs",
    "docx:byte-repro": "node scripts/docx-byte-repro.mjs",
    "docx:level-b-gate": "pnpm check:docx-validator && pnpm build && node scripts/docx-level-b-gate.mjs",
    "docx:level-c-gate": "pnpm check:docx-validator && pnpm build && pnpm docx:level-b-gate && node scripts/docx-level-c-gate.mjs",
    "docx:level-c-gate:local": "pnpm check:docx-validator && pnpm build && pnpm docx:level-b-gate && node scripts/docx-level-c-gate.mjs --allow-missing-libreoffice --allow-missing-pro",
    "docx:engine-gate": "pnpm check:docx-validator && pnpm check:docx-static-gate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docx:byte-repro && pnpm check:source-mode && pnpm check:bundle && pnpm pack:check && pnpm check:release-candidate",
    "typecheck": "pnpm --filter @runstamp/pvce build && pnpm --filter @runstamp/document-diff build && pnpm --filter @runstamp/protocol build && pnpm --filter @runstamp/pdf build && tsc --noEmit",
    "lint": "pnpm exec eslint src __tests__ *.config.ts",
    "test": "pnpm --filter @runstamp/pvce build && pnpm --filter @runstamp/document-diff build && pnpm --filter @runstamp/protocol build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@runstamp/contract": "workspace:*",
    "@runstamp/pdf": "workspace:*",
    "fast-xml-parser": "^5.5.7",
    "jszip": "^3.10.1",
    "node-html-parser": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@runstamp/document-diff": "workspace:*",
    "@runstamp/protocol": "workspace:*",
    "@runstamp/pvce": "workspace:*",
    "@types/node": "^22.0.0",
    "@xarsh/ooxml-validator": "0.1.10",
    "esbuild": "^0.28.2",
    "mammoth": "^1.12.0",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "opentype.js": ">=1.3.0",
    "pdf-lib": ">=1.17.0",
    "sharp": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "opentype.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "runstamp": {
    "packCheck": {
      "forbiddenImportSpecifiers": [
        "@runstamp/protocol",
        "@runstamp/pvce"
      ]
    },
    "publicSourceMode": "independently-buildable"
  }
}
