{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@runstamp/react": ["./src/index.ts"],
      "@runstamp/react/server": ["./src/server.ts"],
      "@runstamp/contract": ["../contract/dist/index.d.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/**/*", "test/**/*", "examples/**/*", "vitest.config.ts", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
