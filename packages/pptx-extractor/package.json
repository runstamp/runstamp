{
  "name": "@runstamp/pptx-extractor",
  "version": "0.0.1",
  "private": true,
  "description": "Open + introspect generated PPTX files. Phase 1 surface: open(), normalize-for-hash, parts listing.",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.7",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/runstamp/runstamp",
    "directory": "packages/pptx-extractor"
  },
  "bugs": "https://github.com/runstamp/runstamp/issues",
  "homepage": "https://runstamp.com",
  "runstamp": {
    "publicSourceMode": "independently-buildable"
  }
}
