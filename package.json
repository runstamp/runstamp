{
  "name": "runstamp-public-source",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.4",
  "workspaces": ["packages/*"],
  "scripts": {
    "verify:export": "node scripts/verify-public-source.mjs",
    "update:export-manifest": "node scripts/update-public-source-manifest.mjs",
    "verify:packages": "node scripts/verify-public-packages.mjs",
    "test:release-policy": "node --test scripts/release-package.test.mjs",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present run lint",
    "test": "pnpm rebuild @xarsh/ooxml-validator && pnpm -r --workspace-concurrency=1 --if-present run test",
    "check": "pnpm verify:export && pnpm test:release-policy && pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm verify:packages"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.2.3",
    "tsx": "^4.20.5",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  }
}
